# OpenClaw Platform — Environment Variables
# Copy to .env and fill in your keys

# Database
DATABASE_URL="postgresql://openclaw:openclaw@localhost:5433/openclaw"

# Redis
REDIS_URL="redis://localhost:6380"

# Claude Sonnet 4.6 (all language tasks)
ANTHROPIC_API_KEY="sk-ant-..."

# Gemini (Nano Banana 2 + Veo 3.1)
GEMINI_API_KEY="..."

# Kling AI (lip sync)
KLING_API_KEY="..."

# Telegram Bot (remote control)
TELEGRAM_BOT_TOKEN="..."

# Edge-TTS voice (default)
DEFAULT_TTS_VOICE="en-US-GuyNeural"

# Content archive path
CONTENT_ARCHIVE_PATH="./content-archive"
